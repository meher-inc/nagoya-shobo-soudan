{
  "name": "todokede-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e",
    "assets": "node scripts/make-assets.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild", "workerd"] }
}
