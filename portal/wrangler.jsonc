{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todokede-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // ai.todokede.jp（Cloudflare for SaaS のカスタムホスト名。SaaS ゾーン meher-edge.com は MeHer の共通基盤）だけをこの Worker に向ける
  "routes": [{ "pattern": "ai.todokede.jp/*", "zone_name": "meher-edge.com" }],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/robots.txt", "/sitemap.xml"]
  },
  "vars": { "CANONICAL_ORIGIN": "https://ai.todokede.jp" }
}
