{
  "name": "nagoya-shobo-soudan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e",
    "screenshots": "SCREENSHOTS=1 playwright test --project=desktop-chrome",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "staging:migrate": "wrangler d1 migrations apply DB --env staging --remote",
    "staging:preview": "vite build && wrangler d1 migrations apply DB --env staging --remote && wrangler versions upload --env staging --preview-alias prelaunch"
  },
  "dependencies": {
    "hono": "4.13.13",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
